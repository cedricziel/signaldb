    "ThrottleBanner": {
      "cardMode": "single",
      "primaryStory": "Visible",
      "skip": [
        "components-throttlebanner--hidden"
      ]
    }
  },
  "storyImports": {
    "shim": [
      "@tanstack/react-query",
      "api/gen/client.gen",
