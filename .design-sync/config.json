{
  "projectId": "6b1371e8-5c56-402a-8c4c-81af3a725fc0",
  "shape": "storybook",
  "storybookConfigDir": "src/ui/.storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "pkg": "signaldb-ui",
  "globalName": "SignalDBUI",
  "srcDir": "src/ui/src/components",
  "entry": ".design-sync/pkg/dist/index.js",
  "cssEntry": "dist/index.css",
  "buildCmd": ".design-sync/pkg/build.sh",
  "titleMap": {
    "SemanticKey": "SemanticKeyLabel",
    "Logs": "LogsView",
    "Traces": "TracesView",
    "Catalog": "CatalogView",
    "Consent": "ConsentView",
    "Errors": "ErrorsView",
    "Instrumentation": "Instrumentation",
    "Manage": "ManagementPanel",
    "Metrics": "MetricsView",
    "Processors": "ProcessorList",
    "Profiles": "ProfilesView",
    "Query": "QueryView",
    "Schema": "SchemaHub",
    "Login": "LoginRoute",
    "AppShell": "ExploreView",
    "APIKeys": "ApiKeys",
    "GitHubIntegration": "GitHubIntegration",
    "SelectTenant": "SelectTenant"
  },
  "provider": {
    "component": "QueryClientProvider",
    "props": {
      "client": {
        "$ref": "previewQueryClient"
      }
    }
  },
  "overrides": {
    "AttributeTable": {
      "cardMode": "column"
    },
    "VizTooltip": {
      "cardMode": "column"
    },
    "Dialog": {
      "cardMode": "single",
      "primaryStory": "Default"
    },
    "MobileSidebarDrawer": {
      "skip": [
        "components-mobilesidebardrawer--open-by-default",
        "components-mobilesidebardrawer--right-side"
      ]
    },
    "SemanticKeyLabel": {
      "skip": [
        "components-semantickey--unresolved"
      ]
    },
    "SourceSnippet": {
      "skip": [
        "components-sourcesnippet--unavailable"
      ]
    },
    "LogsView": {
      "cardMode": "single",
      "primaryStory": "Default",
      "viewport": "1280x800"
    },
    "TracesView": {
      "cardMode": "single",
      "primaryStory": "Default",
      "viewport": "1280x800"
    },
    "CatalogView": {
