{
  "name": "signaldb-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:stories": "playwright test --config=playwright.stories.config.ts",
    "test:e2e:live": "cargo build --bin signaldb --bin signaldb-cli --bin signal-producer && pnpm run build && playwright test --config=playwright.live.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "lint": "eslint src",
    "generate:api": "openapi-ts",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-web": "^0.69.0",
    "@opentelemetry/browser-instrumentation": "^0.9.0",
    "@opentelemetry/context-zone": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-document-load": "^0.69.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "uplot": "^1.6.32",
    "workbox-window": "^7.4.1",
    "yaml": "^2.9.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/client-fetch": "^0.13.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "storybook": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-vitest": "^10.6.4",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-mcp": "^10.6.4",
    "eslint-plugin-storybook": "^10.6.4",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.64.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
