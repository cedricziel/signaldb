# Copy to .env.local (gitignored). The Vite dev server proxies /loki, /tempo,
# /prometheus, and /api to SIGNALDB_TARGET and injects the auth headers below,
# so you can point development at any live SignalDB instance without CORS
# changes and without API keys reaching browser code.

# Local: ./scripts/run-dev.sh (router on :3000). Or a remote instance.
SIGNALDB_TARGET=http://localhost:3000
SIGNALDB_API_KEY=
SIGNALDB_TENANT=default
# Optional; omit to use the tenant's default dataset.
#SIGNALDB_DATASET=production

# --- Browser telemetry (OpenTelemetry) ---
# OTLP/HTTP endpoint browser spans are exported to. Leave empty to disable
# export: the SDK still injects `traceparent` into API calls (end-to-end
# correlation) and, in dev, prints spans to the console. Point at an OTLP
# collector or a SignalDB acceptor's HTTP port; "/v1/traces" is appended if
# absent. The browser cannot send X-Tenant-ID/API keys safely, so route
# through a collector that adds them rather than at a public acceptor.
#SIGNALDB_OTLP_ENDPOINT=http://localhost:4318
# service.name for exported spans.
#SIGNALDB_TELEMETRY_SERVICE_NAME=signaldb-ui
