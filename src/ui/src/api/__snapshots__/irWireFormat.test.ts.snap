0"},"result":"series","pipeline":[{"where":{"field":"service.name","op":"eq","value":"web"}},{"where":{"or":[{"field":"session.id","op":"exists"},{"field":"event_name","op":"eq","value":"browser.web_vital"},{"field":"event_name","op":"eq","value":"browser.navigation"},{"field":"event_name","op":"eq","value":"browser.user_action.click"},{"field":"event_name","op":"eq","value":"browser.resource_timing"}]}},{"aggregate":{"aggs":[{"fn":"count","as":"n","where":{"field":"event_name","op":"eq","value":"browser.navigation"}}],"step":"120s"}}]}},"formulas":[{"name":"sessions","expr":"q_sessions"},{"name":"users","expr":"q_users"},{"name":"sessions_with_errors","expr":"q_sessions_with_errors"},{"name":"page_views","expr":"q_page_views"}],"result":"series"}"`;

