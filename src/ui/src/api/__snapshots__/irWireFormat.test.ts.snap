exports[`IR wire format > buildBackendCauseRequestsDoc 1`] = `"{"irVersion":8,"from":"traces","range":{"from":"1000000000000","to":"4600000000000"},"result":"rows","fields":["session.id","start_time_unix_nano","trace_id","span_id","http.request.method","url.full","http.response.status_code","duration"],"pipeline":[{"where":{"field":"service.name","op":"eq","value":"web"}},{"where":{"field":"span_kind","op":"eq","value":"Client"}},{"where":{"or":[{"field":"status.code","op":"eq","value":"Error"},{"field":"http.response.status_code","op":"gte","value":400}]}},{"where":{"field":"session.id","op":"in","value":["s1","s2"]}},{"order":[{"of":"start_time_unix_nano","dir":"desc"}]},{"limit":5000}]}"`;

exports[`IR wire format > buildBreakdownDoc 1`] = `"{"irVersion":8,"from":"logs","range":{"from":"1000000000000","to":"4600000000000"},"result":"table","pipeline":[{"where":{"field":"service.name","op":"eq","value":"web"}},{"where":{"or":[{"field":"session.id","op":"exists"},{"field":"event_name","op":"eq","value":"browser.web_vital"},{"field":"event_name","op":"eq","value":"browser.navigation"},{"field":"event_name","op":"eq","value":"browser.user_action.click"},{"field":"event_name","op":"eq","value":"browser.resource_timing"}]}},{"where":{"field":"browser.brands","op":"exists"}},{"aggregate":{"by":["browser.brands"],"aggs":[{"fn":"count","as":"n"}]}},{"order":[{"of":"n","dir":"desc"}]},{"limit":5}]}"`;

exports[`IR wire format > buildEntityMetricDocs 1`] = `"[{"irVersion":1,"from":"metrics","range":{"from":"1000000000000","to":"4600000000000"},"result":"series","pipeline":[{"where":{"field":"metric.name","op":"regex","value":"^(system\\\\.cpu\\\\.utilization)$"}},{"where":{"field":"service.name","op":"eq","value":"api"}},{"where":{"field":"service.namespace","op":"eq","value":null}},{"aggregate":{"by":["metric.name"],"aggs":[{"fn":"avg","of":"metric.value","as":"v"}],"step":"60s"}}]},{"irVersion":3,"from":"metrics","range":{"from":"1000000000000","to":"4600000000000"},"result":"series","pipeline":[{"where":{"field":"metric.name","op":"regex","value":"^(http\\\\.server\\\\.request\\\\.duration)$"}},{"where":{"field":"service.name","op":"eq","value":"api"}},{"where":{"field":"service.namespace","op":"eq","value":null}},{"where":{"field":"metric.type","op":"eq","value":"histogram"}},{"histogram_quantile":{"q":0.95,"step":"60s","as":"p95"}}]}]"`;

